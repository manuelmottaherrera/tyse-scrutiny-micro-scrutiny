<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20250206140900-1" author="jhipster">
        <createTable tableName="processed_document">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="pdf_id" type="${uuidType}">
                <constraints nullable="false" unique="true" uniqueConstraintName="ux_processed_document_pdf_id"/>
            </column>
            <column name="file_name" type="varchar(500)">
                <constraints nullable="true"/>
            </column>
            <column name="election_process_id" type="bigint">
                <constraints nullable="true"/>
            </column>
            <column name="stage" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="error_message" type="text">
                <constraints nullable="true"/>
            </column>
            <column name="uploaded_at" type="timestamp">
                <constraints nullable="true"/>
            </column>
            <column name="ocr_completed_at" type="timestamp">
                <constraints nullable="true"/>
            </column>
            <column name="cleaning_completed_at" type="timestamp">
                <constraints nullable="true"/>
            </column>
            <column name="persisted_at" type="timestamp">
                <constraints nullable="true"/>
            </column>
            <column name="analyzed_at" type="timestamp">
                <constraints nullable="true"/>
            </column>
            <column name="created_date" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="true"/>
            </column>
            <column name="last_modified" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <createIndex tableName="processed_document" indexName="idx_doc_status">
            <column name="status"/>
        </createIndex>

        <createIndex tableName="processed_document" indexName="idx_doc_stage">
            <column name="stage"/>
        </createIndex>

        <addForeignKeyConstraint baseTableName="processed_document"
            baseColumnNames="election_process_id"
            constraintName="fk_processed_document_election_process_id"
            referencedTableName="election_process"
            referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>
